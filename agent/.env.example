# Existing backend API base URL, including /api.
CLOUDNET_API_URL=http://localhost:4000/api

# Token returned by: python -m agent.cloudnet_agent register
CLOUDNET_AGENT_TOKEN=replace-with-agent-token

# Admin JWT is only needed for registration.
CLOUDNET_ADMIN_JWT=optional-admin-jwt-for-registration

# Match backend AGENT_REGISTRATION_TOKEN when configured.
CLOUDNET_AGENT_REGISTRATION_TOKEN=optional-backend-agent-registration-token

# Seconds used for each counter sample/submission cycle.
CLOUDNET_AGENT_INTERVAL_SECONDS=60

# Public ICMP probe target for latency, packet loss, and jitter.
CLOUDNET_PROBE_HOST=1.1.1.1
